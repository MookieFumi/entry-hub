{
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "products",
        "Match": { "Path": "/products/{**rest}" }
      }
    },
    "Clusters": {
      "products": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".Balancer.Affinity"
        },
        "Destinations": {
          "instance-1": { "Address": "http://localhost:5501" },
          "instance-2": { "Address": "http://localhost:5502" }
        }
      }
    }
  }
}