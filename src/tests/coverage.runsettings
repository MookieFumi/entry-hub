<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings. Use: dotnet test with the settings file tests/coverage.runsettings and the XPlat Code Coverage collector. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Only the production assembly counts. Generated EF Core migrations are not hand-written code. -->
          <Include>[EntryHub.Api]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
